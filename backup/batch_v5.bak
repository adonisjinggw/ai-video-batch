// ==================== 无限画布 ====================

function setupInfiniteCanvas(containerId, contentId) {
  const container = document.getElementById(containerId);
  const content = document.getElementById(contentId);
  if (!container || !content) return;

  const state = {
    scale: 0.9,
    panning: false,
    x: 0,
    y: 0,
    startX: 0,
    startY: 0
  };

  function apply() {
    content.style.transform = `translate(${state.x}px, ${state.y}px) scale(${state.scale})`;
  }

  container.style.cursor = 'grab';

  container.addEventListener('mousedown', e => {
    if (
      e.target.closest('button') ||
      e.target.closest('input') ||
      e.target.closest('textarea') ||
      e.target.closest('.task-card') ||
      e.target.closest('.result-card') ||
      e.target.closest('.idea-item')
    ) {
      return;
    }
    state.panning = true;
    state.startX = e.clientX - state.x;
    state.startY = e.clientY - state.y;
    container.style.cursor = 'grabbing';
  });

  document.addEventListener('mouseup', () => {
    state.panning = false;
    container.style.cursor = 'grab';
  });

  container.addEventListener('mousemove', e => {
    if (!state.panning) return;
    state.x = e.clientX - state.startX;
    state.y = e.clientY - state.startY;
    apply();
  });

  container.addEventListener('wheel', e => {
    if (!e.ctrlKey && !e.metaKey) return;
    e.preventDefault();
    const delta = -e.deltaY;
    const factor = delta > 0 ? 1.1 : 0.9;
    state.scale = Math.min(3, Math.max(0.3, state.scale * factor));
    apply();
  });

  window.zoomIn = function () {
    state.scale = Math.min(3, state.scale * 1.1);
    apply();
  };
  window.zoomOut = function () {
    state.scale = Math.max(0.3, state.scale / 1.1);
    apply();
  };
  window.resetZoom = function () {
    state.scale = 0.9;
    state.x = 0;
    state.y = 0;
    apply();
  };

  apply();
}

// ==================== 角色库 & 视频合成播放器 ====================

let characterLibrary = [];

function loadCharacterLibrary() {
  try {
    const stored = localStorage.getItem('character_library');
    if (stored) characterLibrary = JSON.parse(stored);
  } catch (e) {
    console.error('加载角色库失败:', e);
    characterLibrary = [];
  }
}

function saveCharacterToLibrary(name, summary, imageUrl) {
  loadCharacterLibrary();
  const character = { name, summary, imageUrl, id: Date.now() };
  
  // 查重（按名字）
  const existingIndex = characterLibrary.findIndex(c => c.name === character.name);
  if (existingIndex >= 0) {
    if (!confirm(`角色 "${character.name}" 已存在角色库中，要覆盖吗？`)) return;
    characterLibrary[existingIndex] = character;
  } else {
    characterLibrary.push(character);
  }
  localStorage.setItem('character_library', JSON.stringify(characterLibrary));
  alert(`角色 "${character.name}" 已保存到角色库！`);
  
  // 如果当前在编辑弹窗，刷新一下
  const modal = document.getElementById('ideaModal');
  if (modal && modal.style.display !== 'none') {
     renderCharacterSelection();
  }
}

function deleteCharacterFromLibrary(index) {
  if (!confirm('确定从角色库删除该角色吗？')) return;
  characterLibrary.splice(index, 1);
  localStorage.setItem('character_library', JSON.stringify(characterLibrary));
  renderCharacterSelection();
}

function renderCharacterSelection() {
  const container = document.getElementById('charLibSelection');
  if (!container) return;
  
  loadCharacterLibrary();
  
  if (characterLibrary.length === 0) {
    container.innerHTML = '<div style="font-size:12px;color:#666;padding:10px;text-align:center;border:1px dashed #333;border-radius:4px;">暂无角色，请在生成结果中保存角色</div>';
    return;
  }
  
  let html = '<div style="display:flex;flex-wrap:wrap;gap:10px;margin-top:8px;">';
  characterLibrary.forEach((char, idx) => {
    html += `
      <div class="char-lib-item" onclick="selectCharacterForIdea(${idx})" style="width:70px;cursor:pointer;transition:transform 0.2s;">
        <div style="position:relative;width:70px;height:70px;">
            <img src="${char.imageUrl}" style="width:100%;height:100%;object-fit:cover;border-radius:4px;border:1px solid #444;">
            <div onclick="event.stopPropagation();deleteCharacterFromLibrary(${idx})" style="position:absolute;top:0;right:0;background:rgba(0,0,0,0.6);color:#fff;width:20px;height:20px;display:flex;align-items:center;justify-content:center;border-radius:0 4px 0 4px;font-size:14px;line-height:1;">×</div>
        </div>
        <div style="font-size:10px;color:#ccc;text-align:center;margin-top:4px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${char.name}</div>
      </div>
    `;
  });
  html += '</div>';
  container.innerHTML = html;
}

function selectCharacterForIdea(index) {
  const char = characterLibrary[index];
  if (!char) return;
  
  const themeInput = document.getElementById('ideaTheme');
  if (themeInput) {
      if (!themeInput.value.includes(char.name)) {
          const appendText = ` (主角：${char.name}，${char.summary})`;
          themeInput.value = themeInput.value + appendText;
          // 闪烁提示
          themeInput.style.borderColor = 'var(--accent-gold)';
          setTimeout(() => themeInput.style.borderColor = '', 500);
      } else {
          alert('该角色似乎已在主题中。');
      }
  }
}

function renderVideoPlayer(ideaId, videoUrls) {
    if (!videoUrls || videoUrls.length === 0) return '';
    
    // 序列化 URL 数组以便传递
    const urlsJson = JSON.stringify(videoUrls).replace(/"/g, '&quot;');
    
    return `
      <div class="mind-node">
        <div class="mind-node-title" style="color:var(--accent-gold);">▶️ 视频合成预览</div>
        <div class="mind-node-content">
           <div class="video-player-container" id="player-${ideaId}" style="background:#000;border-radius:8px;overflow:hidden;margin-top:10px;border:1px solid #333;">
              <video id="v-${ideaId}" src="${videoUrls[0]}" controls style="width:100%;aspect-ratio:16/9;display:block;" onended="playNextClip('${ideaId}', this)"></video>
              <div style="padding:8px 12px;background:#111;font-size:12px;color:#888;display:flex;justify-content:space-between;align-items:center;border-top:1px solid #222;">
                 <span id="p-status-${ideaId}">正在播放第 1 / ${videoUrls.length} 片段</span>
                 <button class="btn-secondary" onclick="replayAll('${ideaId}')" style="padding:2px 8px;font-size:11px;height:24px;line-height:20px;">↺ 重播全片</button>
              </div>
              <div style="display:none;" id="playlist-${ideaId}" data-urls="${urlsJson}"></div>
           </div>
        </div>
      </div>
    `;
}

window.playNextClip = function(ideaId, videoEl) {
    const playlistEl = document.getElementById(`playlist-${ideaId}`);
    if (!playlistEl) return;
    
    const urls = JSON.parse(playlistEl.getAttribute('data-urls'));
    // 获取当前播放的 URL（由于 src 可能是绝对路径，这里简化判断）
    const currentSrc = videoEl.src;
    
    // 简单遍历找到当前索引
    let idx = -1;
    for(let i=0; i<urls.length; i++) {
        if (currentSrc.includes(urls[i]) || urls[i].includes(currentSrc)) {
            idx = i;
            break;
        }
    }
    
    if (idx === -1) idx = 0;
    
    if (idx < urls.length - 1) {
        const nextUrl = urls[idx + 1];
        videoEl.src = nextUrl;
        videoEl.play();
        document.getElementById(`p-status-${ideaId}`).textContent = `正在播放第 ${idx + 2} / ${urls.length} 片段`;
    } else {
        document.getElementById(`p-status-${ideaId}`).textContent = `全片播放结束`;
    }
};

window.replayAll = function(ideaId) {
    const playlistEl = document.getElementById(`playlist-${ideaId}`);
    if (!playlistEl) return;
    const urls = JSON.parse(playlistEl.getAttribute('data-urls'));
    const videoEl = document.getElementById(`v-${ideaId}`);
    if (urls.length > 0 && videoEl) {
        videoEl.src = urls[0];
        videoEl.play();
        document.getElementById(`p-status-${ideaId}`).textContent = `正在播放第 1 / ${urls.length} 片段`;
    }
};

// ==================== 工具函数 & 初始化 ====================

function sleep(ms) {
    return new Promise(resolve => setTimeout(resolve, ms));
}

document.addEventListener('DOMContentLoaded', () => {
  const settings = loadSettings();
  document.getElementById('settingZhenzhenKey').value = settings.zhenzhenKey || '';
  document.getElementById('settingRhKey').value = settings.rhKey || '';

  ideas = loadIdeasFromHistory();
  
  // 恢复未完成任务的状态
  let hasRecoveredTasks = false;
  ideas.forEach(idea => {
      if (idea.status === 'processing') {
          idea.status = 'paused'; // 页面刷新后，原本运行的任务被迫中断，置为暂停
          if (!idea.error) idea.error = '页面刷新，任务已暂停';
          hasRecoveredTasks = true;
      }
  });
  if (hasRecoveredTasks) {
      saveIdeasToHistory();
  }

  renderIdeasList();
  renderCanvas(); // 确保刷新后显示右侧内容
  updateUsageDisplay();
  updateBatchButton();

  // 默认尝试开启语音（浏览器会弹权限框）
  setTimeout(() => {
    try {
      toggleVoiceInput();
    } catch {
      // 忽略失败
    }
  }, 600);
});

function openEditingStudio() {
    const studio = document.getElementById('editingStudioFrame');
    const main = document.querySelector('.content-area');
    if (studio && main) {
        main.style.display = 'none';
        studio.style.display = 'block';
    }
}

function closeEditingStudio() {
    const studio = document.getElementById('editingStudioFrame');
    const main = document.querySelector('.content-area');
    if (studio && main) {
        studio.style.display = 'none';
        main.style.display = 'flex'; // flex for sidebar layout
        // 重新渲染可能更新的内容
        renderCanvas();
    }
}


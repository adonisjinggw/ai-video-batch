            fill_104: { name: '圣诞红包封面（竖版）', template: '圣诞主题红包封面设计，1080x1920 竖版，主视觉：______（主题：圣诞树礼盒/雪花/圣诞老人/麋鹿/铃铛），金色烫金与浮雕质感，红绿金节日配色，四周预留安全区留白（不要贴边），中部留出祝福文案“______（祝福语）”，底部留出署名/品牌位“______（署名/品牌）”，干净高级，高清细节，无水印' },
            fill_105: { name: '春节贺卡（竖版）', template: '春节贺卡设计，1080x1920 竖版，中国红+金色点缀，国风插画风格，主视觉：______（主题：龙/蛇/生肖/财神/灯笼/烟花），祥云纹样与金粉散景，烫金标题“______（新年快乐/恭喜发财/大吉大利）”，副标题“______（祝福语/署名）”，四周留安全区留白，高清细节，无水印' },
            fill_106: { name: '春节红包封面（竖版）', template: '微信红包封面设计（春节主题），1080x1920 竖版，中国红底+金色烫金浮雕，主视觉：______（生肖/财神/舞狮/灯笼/年货），背景暗纹：祥云/回纹/剪纸纹理，四周预留安全区留白（不要贴边），中部留出祝福文案“______（祝福语）”，底部留出署名/品牌位“______（署名/品牌）”，高清细节，无水印' },
            fill_107: { name: '圣诞红包内页（开红包页面）', template: '微信红包内页设计（圣诞主题/开红包页面），1080x1920 竖版，整体高级简洁，顶部保留安全区留白。背景氛围：圣诞树枝、雪花、暖光灯串、金粉散景bokeh（不要遮挡主体信息）。信息区域排版清晰：1) 顶部：发送者/品牌署名“______（From/品牌名/昵称）”；2) 中部：祝福语大字“______（祝福语）”，字形清晰可读，烫金或金属质感；3) 下方：金额展示区域“______（金额/如 8.88）元”或“______（口令/福利）”，留出醒目空间；4) 底部：小字说明/活动规则“______（说明）”，并预留一个二维码/Logo 占位区（用空白框表示，不要生成真实二维码）。配色：深绿+金 或 红绿金；材质：丝绒/磨砂卡纸/局部UV；整体干净、无水印、无乱码文字、四周留安全区。' },
            fill_108: { name: '春节红包内页（开红包页面）', template: '微信红包内页设计（春节主题/开红包页面），1080x1920 竖版，中国红底+金色点缀，高级克制国风（不过度花哨），顶部保留安全区留白。背景暗纹：祥云/回纹/锦缎纹理/剪纸暗纹，金粉散景bokeh（不要遮挡主体信息）。信息区域排版清晰：1) 顶部：发送者/品牌署名"______（品牌名/昵称/From）"；2) 中部：祝福语大字"______（祝福语）"，烫金浮雕质感，字形清晰可读；3) 下方：金额展示区域"______（金额/如 88.88）元"或"______（口令/福利）"，留出醒目空间；4) 底部：小字说明/活动规则"______（说明）"，并预留一个二维码/Logo 占位区（用空白框表示，不要生成真实二维码）。主视觉可点缀：灯笼、舞狮、金元宝、福字、烟花；整体干净高级、无水印、无乱码文字、四周留安全区。' },
            knolling: { name: 'Knolling万物拆解', template: 'Knolling layout of ______（填写物品名称），neatly arranged components, top-down view, organized flat lay, professional product photography, white background, soft shadows, 8K detail' },
            ghibli_style: { name: '吉卜力风格', template: '将{subject}转换为吉卜力工作室动画风格，柔和水彩质感，温暖色调，梦幻氛围，细腻背景细节，宫崎骏电影美学，手绘动画质感' },
            pixar_3d: { name: 'Pixar 3D风格', template: '生成{character}的3D头像，Pixar动画风格，灿烂笑容，干净白色背景，概念数字艺术，高质量渲染，柔和光照，光滑纹理，色彩鲜明，卡通感但比例真实' },
            cyberpunk_style: { name: '赛博朋克风格', template: '将{subject}转换为赛博朋克风格，霓虹灯光，雨夜城市背景，全息投影元素，机械增强细节，紫色和青色主色调，高对比度，未来科技感' },
            watercolor_art: { name: '水彩艺术风格', template: '将{subject}转换为水彩画风格，柔和色彩渐变，纸张纹理质感，颜料晕染效果，留白艺术，传统手绘美感，艺术画廊品质' },
            oil_painting: { name: '油画风格', template: '将{subject}转换为古典油画风格，厚重笔触，丰富色彩层次，戏剧性光影，伦勃朗式打光，博物馆级艺术品质感，金色画框效果' },
            valentines: { name: '情人节主题', template: '【主题】情人节 / Valentine\'s Day\n【主体】{subject}\n【场景】{scene}\n【氛围】{mood}\n【色彩】{color}\n【元素】{elements}\n【质量】8K高清，浪漫唯美，光影柔和' },
            impressionism: { name: '印象派', template: '将______（场景）转换为印象派画风，点彩笔触，柔和光影，莫奈风格，艺术感强烈' },
            surrealism: { name: '超现实主义', template: '______的超现实主义画作，达利风格，梦境元素，非理性组合，融化的时钟，潜意识表达' },
            pop_art: { name: '波普艺术', template: '将______转换为安迪·沃霍尔波普艺术风格，大胆色彩，重复图案，商业美学，高对比度' },
            ink_wash: { name: '水墨画', template: '______的中国水墨画风格，黑白灰层次，留白意境，泼墨写意，东方美学，禅意空灵' }
        };

        function useFillTemplate() {
            const select = document.getElementById('fillTemplateSelect');
            const preview = document.getElementById('fillPreview');
            const input = document.getElementById('conceptInput');
            const key = select.value;

            if (!key || !fillTemplates[key]) {
                preview.style.display = 'none';
                return;
            }

            const tpl = fillTemplates[key];
            preview.innerHTML = '<b>' + tpl.name + '</b><br>' + tpl.template.replace('______', '<span style="color:var(--accent);font-weight:bold;">[在上方输入主题]</span>');
            preview.style.display = 'block';

            // 自动填充模板到输入框
            input.value = tpl.template;
            input.focus();
            showToast('已选择模板，请替换______为你的主题');
        }

        function useTemplate(type) {
            const input = document.getElementById('conceptInput');
            input.value = templates[type] + input.value;
            input.focus();
        }

        async function generatePrompt() {
            const concept = document.getElementById('conceptInput').value.trim();
            if (!concept) {
                showToast('请输入创意概念');
                return;
            }

            const style = document.getElementById('styleSelect').value;
            const detail = document.getElementById('detailSelect').value;
            const btn = document.getElementById('generateBtn');
            const loading = document.getElementById('loading');
            const result = document.getElementById('resultSection');

            btn.disabled = true;
            loading.style.display = 'block';
            result.style.display = 'none';

            const styleMap = {
                realistic: '写实摄影风格，高清细节，专业打光',
                artistic: '艺术绘画风格，油画质感，大师级构图',
                anime: '日本动漫风格，精致线条，鲜艳色彩',
                '3d': '3D渲染风格，Octane渲染，体积光',
                abstract: '抽象艺术风格，几何构成，色彩碰撞'
            };

            const detailMap = {
                simple: '',
                medium: '，细节丰富，画面精致',
                detailed: '，超高细节，8K分辨率，精雕细琢',
                ultra: '，极致细节，16K超清，每个元素都精心设计，award winning'
            };

            try {
                const response = await fetch('/api/yunwu', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        action: 'text',
                        model: 'gemini-2.5-flash',
                        prompt: `你是一个专业的AI绘画提示词专家。请将以下创意概念优化成一个专业的英文提示词，用于AI图像生成。

创意概念：${concept}
风格要求：${styleMap[style]}
详细程度：${detailMap[detail]}

要求：
1. 输出纯英文提示词
2. 包含主体描述、风格、光影、构图等元素
3. 使用逗号分隔各个描述词
4. 不要解释，直接输出提示词`
                    })
                });

                const data = await response.json();
                currentPrompt = data.content || data.response || data.text || '';

                document.getElementById('resultText').textContent = currentPrompt;
                result.style.display = 'block';
                showToast('提示词生成成功！');
            } catch (error) {
                showToast('生成失败：' + error.message);
            } finally {
                btn.disabled = false;
                loading.style.display = 'none';
            }
        }

        function copyPrompt() {
            if (!currentPrompt) {
                showToast('没有可复制的提示词');
                return;
            }
            navigator.clipboard.writeText(currentPrompt);
            showToast('已复制到剪贴板');
        }

        function usePrompt() {
            if (!currentPrompt) {
                showToast('请先生成提示词');
                return;
            }
            localStorage.setItem('knolling_prompt', currentPrompt);
            location.href = 'banana.html';
        }

        function showToast(msg) {
            const toast = document.getElementById('toast');
            toast.textContent = msg;
            toast.classList.add('show');
            setTimeout(() => toast.classList.remove('show'), 2500);
        }

        // 检查是否有传递过来的提示词
        document.addEventListener('DOMContentLoaded', () => {
            const savedPrompt = localStorage.getItem('knolling_prompt');
            if (savedPrompt) {
                localStorage.removeItem('knolling_prompt');
            }
        });
    </script>
</body>

</html>
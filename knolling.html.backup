<!DOCTYPE html>
<html lang="zh-CN">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>📝 提示词工坊 - RollRoll</title>
    <style>
        :root {
            --bg-dark: #0a0a0a;
            --bg-card: #1a1a1a;
            --bg-input: #222;
            --text: #fff;
            --text-dim: #888;
            --accent: #fbbf24;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: var(--bg-dark);
            color: var(--text);
            min-height: 100vh;
            padding-bottom: env(safe-area-inset-bottom);
        }

        .header {
            position: sticky;
            top: 0;
            background: var(--bg-dark);
            padding: 16px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid #222;
            z-index: 100;
        }

        .header h1 {
            font-size: 18px;
        }

        .back-btn {
            background: none;
            border: none;
            color: var(--accent);
            font-size: 16px;
            cursor: pointer;
        }

        .main {
            padding: 20px;
            max-width: 600px;
            margin: 0 auto;
        }

        .input-section {
            margin-bottom: 20px;
        }

        .input-label {
            display: block;
            font-size: 14px;
            color: var(--text-dim);
            margin-bottom: 8px;
        }

        .input-box {
            width: 100%;
            background: var(--bg-input);
            border: 1px solid #333;
            border-radius: 12px;
            padding: 16px;
            color: var(--text);
            font-size: 16px;
            resize: none;
            min-height: 80px;
        }

        .input-box:focus {
            outline: none;
            border-color: var(--accent);
        }

        .template-section {
            margin-bottom: 20px;
        }

        .template-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 10px;
        }

        .template-item {
            padding: 12px;
            background: var(--bg-card);
            border-radius: 10px;
            cursor: pointer;
            font-size: 13px;
            text-align: center;
        }

        .template-item:active {
            background: rgba(251, 191, 36, 0.2);
        }

        .template-item .icon {
            font-size: 24px;
            margin-bottom: 6px;
        }

        .settings-row {
            display: flex;
            gap: 12px;
            margin-bottom: 16px;
        }

        .setting-item {
            flex: 1;
        }

        .setting-item label {
            display: block;
            font-size: 12px;
            color: var(--text-dim);
            margin-bottom: 6px;
        }

        .setting-item select {
            width: 100%;
            background: var(--bg-input);
            border: 1px solid #333;
            border-radius: 8px;
            padding: 12px;
            color: var(--text);
            font-size: 14px;
        }

        .generate-btn {
            width: 100%;
            background: linear-gradient(135deg, var(--accent), #f59e0b);
            border: none;
            border-radius: 12px;
            padding: 16px;
            color: #000;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            margin-top: 20px;
        }

        .generate-btn:disabled {
            opacity: 0.5;
        }

        .result-section {
            margin-top: 24px;
            background: var(--bg-card);
            border-radius: 12px;
            padding: 16px;
        }

        .result-title {
            font-size: 14px;
            color: var(--accent);
            margin-bottom: 12px;
        }

        .result-text {
            font-size: 15px;
            line-height: 1.6;
            white-space: pre-wrap;
        }

        .result-actions {
            display: flex;
            gap: 12px;
            margin-top: 16px;
        }

        .result-btn {
            flex: 1;
            padding: 12px;
            border-radius: 8px;
            border: 1px solid #333;
            background: var(--bg-input);
            color: var(--text);
            font-size: 14px;
            cursor: pointer;
        }

        .result-btn.primary {
            background: var(--accent);
            border-color: var(--accent);
            color: #000;
        }

        .loading {
            text-align: center;
            padding: 40px;
            color: var(--text-dim);
        }

        .spinner {
            width: 40px;
            height: 40px;
            border: 3px solid var(--bg-card);
            border-top-color: var(--accent);
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin: 0 auto 16px;
        }

        @keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        .toast {
            position: fixed;
            bottom: 100px;
            left: 50%;
            transform: translateX(-50%);
            background: var(--bg-card);
            padding: 12px 20px;
            border-radius: 8px;
            font-size: 14px;
            display: none;
            z-index: 1000;
        }

        .toast.show {
            display: block;
        }

        /* 填空模式样式 */
        .mode-tabs {
            display: flex;
            gap: 8px;
            margin-bottom: 20px;
        }

        .mode-tab {
            flex: 1;
            padding: 12px;
            background: var(--bg-card);
            border: 1px solid #333;
            border-radius: 8px;
            color: var(--text-dim);
            font-size: 14px;
            cursor: pointer;
            text-align: center;
        }

        .mode-tab.active {
            background: var(--accent);
            border-color: var(--accent);
            color: #000;
        }

        .fill-section {
            display: none;
        }

        .fill-section.active {
            display: block;
        }

        .fill-row {
            margin-bottom: 12px;
        }

        .fill-label {
            font-size: 12px;
            color: var(--text-dim);
            margin-bottom: 4px;
        }

        .fill-input {
            width: 100%;
            background: var(--bg-input);
            border: 1px solid #333;
            border-radius: 8px;
            padding: 10px 12px;
            color: var(--text);
            font-size: 14px;
        }

        .fill-input:focus {
            outline: none;
            border-color: var(--accent);
        }

        .fill-preview {
            background: var(--bg-card);
            border-radius: 8px;
            padding: 12px;
            margin-top: 12px;
            font-size: 13px;
            line-height: 1.6;
            color: var(--text-dim);
        }

        .fill-preview strong {
            color: var(--accent);
        }
    </style>
</head>

<body>
    <header class="header">
        <button class="back-btn" onclick="history.back()">← 返回</button>
        <h1>📝 提示词工坊</h1>
        <div style="width: 50px;"></div>
    </header>

    <main class="main">
        <div class="input-section">
            <label class="input-label">✨ 输入你想要的创意概念</label>
            <textarea class="input-box" id="conceptInput" placeholder="例如：赛博朋克风格的猫咪战士..."></textarea>
        </div>

        <div class="template-section">
            <label class="input-label">✏️ 一键填空模板</label>
            <select id="fillTemplateSelect" onchange="useFillTemplate()"
                style="width:100%; background:var(--bg-input); border:1px solid #333; border-radius:8px; padding:12px; color:var(--text); font-size:14px; margin-bottom:12px;">
                <option value="">-- 选择填空模板 --</option>
                <optgroup label="🎯 热门填空">
                    <option value="fill_1">✨ 梦幻光效人物</option>
                    <option value="fill_2">🎨 动漫风格转换</option>
                    <option value="fill_3">🌸 樱花树下场景</option>
                    <option value="fill_4">🔥 史诗战斗场景</option>
                    <option value="fill_5">🌙 月光夜景</option>
                    <option value="fill_6">🎭 多重身份展示</option>
                    <option value="fill_7">🏠 房间场景设计</option>
                    <option value="fill_8">🎪 Q版可爱化</option>
                    <option value="fill_9">🌈 彩虹渐变效果</option>
                    <option value="fill_10">📸 复古胶片风</option>
                    <option value="fill_11">🎮 像素游戏风格</option>
                    <option value="fill_12">🌊 水下奇幻世界</option>
                    <option value="fill_13">⚡ 赛博朋克风格</option>
                    <option value="fill_14">🍃 森林精灵氛围</option>
                    <option value="fill_15">🎨 油画艺术效果</option>
                    <option value="fill_16">🦸 超级英雄变身</option>
                    <option value="fill_17">🎪 马戏团表演场景</option>
                    <option value="fill_18">🏰 中世纪幻想</option>
                    <option value="fill_19">🌸 中国风工笔画</option>
                    <option value="fill_20">🎭 表情包生成器</option>
                </optgroup>
                <optgroup label="✨ 更多填空">
                    <option value="fill_21">🌟 星空下的场景</option>
                    <option value="fill_22">🔮 水晶质感效果</option>
                    <option value="fill_23">🎨 街头涂鸦风格</option>
                    <option value="fill_24">🌺 热带度假氛围</option>
                    <option value="fill_25">❄️ 冰雪奇缘风格</option>
                    <option value="fill_26">🎭 二次元idol</option>
                    <option value="fill_27">🌆 都市夜景霓虹</option>
                    <option value="fill_28">🎃 万圣节主题</option>
                    <option value="fill_29">🎄 圣诞节氛围</option>
                    <option value="fill_30">🌸 和服写真</option>
                    <option value="fill_31">🎪 小丑马戏团</option>
                    <option value="fill_32">🦋 蝴蝶仙子</option>
                    <option value="fill_33">🐉 东方龙元素</option>
                    <option value="fill_34">🔥 火焰战神</option>
                    <option value="fill_35">⚡ 闪电超能力</option>
                    <option value="fill_36">🌊 海浪冲浪</option>
                    <option value="fill_37">🎸 摇滚音乐会</option>
                    <option value="fill_38">📚 图书馆学霸</option>
                    <option value="fill_39">☕ 咖啡馆悠闲</option>
                    <option value="fill_40">🌈 彩虹独角兽</option>
                    <option value="fill_41">🎨 印象派画风</option>
                    <option value="fill_42">🎭 京剧脸谱</option>
                    <option value="fill_43">🦸‍♀️ 女超人装扮</option>
                    <option value="fill_44">🌙 月亮公主</option>
                    <option value="fill_45">☀️ 太阳神</option>
                    <option value="fill_46">🎪 小丑女Harley Quinn</option>
                    <option value="fill_47">🌟 星际战士</option>
                    <option value="fill_48">🦇 蝙蝠侠风格</option>
                    <option value="fill_49">🕷️ 蜘蛛侠变身</option>
                    <option value="fill_50">🐱 猫耳娘</option>
                    <option value="fill_51">🦊 狐狸精</option>
                    <option value="fill_52">🐺 狼人变身</option>
                    <option value="fill_53">🧛 吸血鬼伯爵</option>
                    <option value="fill_54">👻 幽灵少女</option>
                    <option value="fill_55">🤖 机器人改造</option>
                    <option value="fill_56">🎀 Lolita洋装</option>
                    <option value="fill_57">⚔️ 女武士</option>
                    <option value="fill_58">🏹 精灵弓箭手</option>
                    <option value="fill_59">🪄 魔法少女</option>
                    <option value="fill_60">🎩 绅士礼帽</option>
                    <option value="fill_61">👑 皇室贵族</option>
                    <option value="fill_62">🎓 毕业纪念</option>
                    <option value="fill_63">💼 职场精英</option>
                    <option value="fill_64">🍰 甜品师</option>
                    <option value="fill_65">🌻 向日葵田</option>
                    <option value="fill_66">🌾 麦田守望者</option>
                    <option value="fill_67">🌵 沙漠探险</option>
                    <option value="fill_68">🏔️ 雪山登顶</option>
                    <option value="fill_69">🌋 火山背景</option>
                    <option value="fill_70">🌀 时空漩涡</option>
                    <option value="fill_71">🎆 烟花节日</option>
                    <option value="fill_72">🌃 城市楼顶</option>
                    <option value="fill_73">🚂 蒸汽朋克</option>
                    <option value="fill_74">🎪 马戏团小丑</option>
                    <option value="fill_75">🎠 旋转木马</option>
                    <option value="fill_76">🎡 摩天轮剪影</option>
                    <option value="fill_77">🎢 过山车刺激</option>
                    <option value="fill_78">🎪 杂技演员</option>
                    <option value="fill_79">🎯 射箭运动</option>
                    <option value="fill_80">⚽ 足球明星</option>
                    <option value="fill_81">🏀 篮球灌篮</option>
                    <option value="fill_82">🎾 网球比赛</option>
                    <option value="fill_83">🏊 游泳健将</option>
                    <option value="fill_84">🚴 自行车骑行</option>
                    <option value="fill_85">🧘 瑜伽冥想</option>
                    <option value="fill_86">💆 SPA放松</option>
                    <option value="fill_87">💅 美甲艺术</option>
                    <option value="fill_88">💄 化妆教程</option>
                    <option value="fill_89">👗 时装走秀</option>
                    <option value="fill_90">📷 摄影师视角</option>
                    <option value="fill_91">🎬 导演片场</option>
                    <option value="fill_92">🎤 歌手舞台</option>
                    <option value="fill_93">🎹 钢琴演奏</option>
                    <option value="fill_94">🎻 小提琴演奏</option>
                    <option value="fill_95">🥁 架子鼓表演</option>
                    <option value="fill_96">🎧 DJ打碟</option>
                    <option value="fill_97">🍜 拉面师傅</option>
                    <option value="fill_98">🍣 寿司大师</option>
                    <option value="fill_99">🎂 蛋糕装饰</option>
                    <option value="fill_100">🍕 披萨制作</option>
                    <option value="fill_101">🎄 圣诞夜温馨场景</option>
                    <option value="fill_102">🧧 春节年味大片</option>
                    <option value="fill_103">🎄 圣诞贺卡（竖版）</option>
                    <option value="fill_104">🎁 圣诞红包封面（竖版）</option>
                    <option value="fill_105">🧧 春节贺卡（竖版）</option>
                    <option value="fill_106">🧧 春节红包封面（竖版）</option>
                    <option value="fill_107">🎁 圣诞红包内页（开红包页面）</option>
                    <option value="fill_108">🧧 春节红包内页（开红包页面）</option>
                </optgroup>
                <optgroup label="🎬 专业模板">
                    <option value="knolling">🧩 Knolling万物拆解</option>
                    <option value="ghibli_style">🏯 吉卜力风格</option>
                    <option value="pixar_3d">🎪 Pixar 3D风格</option>
                    <option value="watercolor_art">🎨 水彩艺术风格</option>
                    <option value="cyberpunk_style">🌆 赛博朋克风格</option>
                    <option value="oil_painting">🖼️ 油画风格</option>
                </optgroup>
                <optgroup label="📸 摄影风格">
                    <option value="portrait_photo">📷 专业人像</option>
                    <option value="street_photo">🏙️ 街头摄影</option>
                    <option value="film_photo">🎞️ 胶片质感</option>
                    <option value="macro_photo">🔍 微距特写</option>
                </optgroup>
                <optgroup label="🎄 节日主题">
                    <option value="fill_101">🎄 圣诞节</option>
                    <option value="fill_102">🧧 春节</option>
                    <option value="valentines">💕 情人节</option>
                    <option value="fill_28">🎃 万圣节</option>
                </optgroup>
                <optgroup label="✨ 艺术风格">
                    <option value="impressionism">🖼️ 印象派</option>
                    <option value="surrealism">🌀 超现实主义</option>
                    <option value="pop_art">🎨 波普艺术</option>
                    <option value="ink_wash">🖌️ 水墨画</option>
                </optgroup>
            </select>

            <div id="fillPreview"
                style="display:none; background:var(--bg-card); border-radius:8px; padding:12px; margin-bottom:12px; font-size:13px; line-height:1.6; color:var(--text-dim);">
            </div>
        </div>

        <div class="template-section">
            <label class="input-label">🎯 快速模板</label>
            <div class="template-grid">
                <div class="template-item" onclick="useTemplate('portrait')">
                    <div class="icon">👤</div>
                    <div>人物肖像</div>
                </div>
                <div class="template-item" onclick="useTemplate('landscape')">
                    <div class="icon">🏞️</div>
                    <div>风景场景</div>
                </div>
                <div class="template-item" onclick="useTemplate('product')">
                    <div class="icon">📦</div>
                    <div>产品展示</div>
                </div>
                <div class="template-item" onclick="useTemplate('anime')">
                    <div class="icon">🎌</div>
                    <div>动漫插画</div>
                </div>
                <div class="template-item" onclick="useTemplate('food')">
                    <div class="icon">🍜</div>
                    <div>美食摄影</div>
                </div>
                <div class="template-item" onclick="useTemplate('architecture')">
                    <div class="icon">🏛️</div>
                    <div>建筑设计</div>
                </div>
            </div>
        </div>

        <div class="settings-row">
            <div class="setting-item">
                <label>风格倾向</label>
                <select id="styleSelect">
                    <option value="realistic">写实摄影</option>
                    <option value="artistic">艺术绘画</option>
                    <option value="anime">动漫风格</option>
                    <option value="3d">3D渲染</option>
                    <option value="abstract">抽象艺术</option>
                </select>
            </div>
            <div class="setting-item">
                <label>详细程度</label>
                <select id="detailSelect">
                    <option value="simple">简洁</option>
                    <option value="medium" selected>适中</option>
                    <option value="detailed">详细</option>
                    <option value="ultra">超详细</option>
                </select>
            </div>
        </div>

        <button class="generate-btn" id="generateBtn" onclick="generatePrompt()">
            ⚡ 生成提示词
        </button>

        <div class="loading" id="loading" style="display:none;">
            <div class="spinner"></div>
            <div>正在优化提示词...</div>
        </div>

        <div class="result-section" id="resultSection" style="display:none;">
            <div class="result-title">✨ 优化后的提示词</div>
            <div class="result-text" id="resultText"></div>
            <div class="result-actions">
                <button class="result-btn" onclick="copyPrompt()">📋 复制</button>
                <button class="result-btn primary" onclick="usePrompt()">🎨 去生图</button>
            </div>
        </div>
    </main>

    <div class="toast" id="toast"></div>

    <script>
        let currentPrompt = '';

        const templates = {
            portrait: '一个人物肖像，',
            landscape: '一幅风景画面，',
            product: '产品展示图，',
            anime: '动漫风格插画，',
            food: '美食摄影，',
            architecture: '建筑设计图，'
        };

        // 填空模板库
        const fillTemplates = {
            fill_1: { name: '梦幻光效人物', template: '一个______，周围环绕着闪亮的魔法光粒子和蝴蝶，梦幻氛围，电影感打光，4K高清' },
            fill_2: { name: '动漫风格转换', template: '将______转换为精美日本动漫风格，大眼睛，柔和色彩，动漫质感，高清细节' },
            fill_3: { name: '樱花树下场景', template: '______站在盛开的樱花树下，花瓣飘落，温柔粉色氛围，电影级构图，柔和光影' },
            fill_4: { name: '史诗战斗场景', template: '______正在激烈战斗，动作帅气，火焰/闪电特效环绕，史诗级构图，动态模糊，电影感' },
            fill_5: { name: '月光夜景', template: '______在月光下，星空璀璨，宁静唯美氛围，冷色调，电影级画质' },
            fill_6: { name: '多重身份展示', template: '同一个______（人物）展示多种职业/风格：左边是______（职业1），中间是______（职业2），右边是______（职业3），创意拼贴风格' },

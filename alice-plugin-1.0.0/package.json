{
  "name": "alice-plugin",
  "displayName": "艾莉丝 (Alice) - 智能AI助手",
  "version": "1.0.0",
  "description": "艾莉丝 - 多模型集成，安全可靠的代码助手，智能调用不同AI服务",
  "main": "src/platforms/vscode-extension.js",
  "scripts": {
    "test": "node --test",
    "lint": "eslint src/"
  },
  "keywords": [
    "ai",
    "alice",
    "vscode",
    "plugin",
    "gpt",
    "claude",
    "orchestrator"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": ""
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "node-fetch": "^2.6.12"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.75.0",
    "eslint": "^8.0.0"
  },
  "activationEvents": [
    "onCommand:alice.start",
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:python"
  ],
  "contributes": {
    "commands": [
      {
        "command": "alice.start",
        "title": "艾莉丝: 启动助手"
      },
      {
        "command": "alice.configure",
        "title": "艾莉丝: 配置AI服务"
      },
      {
        "command": "alice.codeReview",
        "title": "艾莉丝: 代码审查"
      }
    ],
    "configuration": {
      "title": "艾莉丝 (Alice)",
      "properties": {
        "alice.aiServices": {
          "type": "array",
          "default": [],
          "description": "配置的AI服务列表"
        },
        "alice.safetyMode": {
          "type": "boolean",
          "default": true,
          "description": "启用安全模式（防止乱改代码）"
        }
      }
    }
  }
}
